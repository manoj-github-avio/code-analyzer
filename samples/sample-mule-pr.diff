+    price:    $.unitPrice as Number,
+    subtotal: $.unitPrice as Number * $.quantity
   }
 }]]></ee:set-payload>
       </ee:message>
     </ee:transform>

+    <logger level="INFO"
+            message='#["[" ++ vars.correlationId ++ "] Processing order " ++ payload.orderId]'
+            doc:name="Log order start"/>
+
     <db:insert config-ref="Orders_DB_Config" doc:name="Insert order header">
       <db:sql>INSERT INTO orders (id, customer_id, total, currency)
