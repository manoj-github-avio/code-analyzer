+    <set-variable variableName="correlationId" value="#[correlationId]" doc:name="Save Correlation ID"/>
+
     <ee:transform doc:name="Map incoming order">
       <ee:message>
         <ee:set-payload><![CDATA[%dw 2.0
@@ -23,11 +25,17 @@
 {
   orderId:    payload.id,
