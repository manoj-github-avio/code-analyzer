+              VALUES (:orderId, :customerId, :total, :currency)</db:sql>
       <db:input-parameters><![CDATA[#[{
         orderId:    payload.orderId,
         customerId: payload.customerId,
-        total:      payload.total
+        total:      payload.total,
+        currency:   payload.currency
       }]]]></db:input-parameters>
     </db:insert>

@@ -48,14 +62,30 @@
           </db:input-parameters>
         </db:insert>
       </foreach>
-    </db:insert>

+    <sfdc:create config-ref="Salesforce_Config" type="Order__c" doc:name="Create Salesforce Order">
+      <sfdc:records><![CDATA[#[[{
+        MuleSoft_Order_Id__c: payload.orderId,
+        Customer_Id__c:       payload.customerId,
+        Total_Amount__c:      payload.total,
+        Currency_Code__c:     payload.currency,
+        Status__c:            "New"
+      }]]]]></sfdc:records>
+    </sfdc:create>
+
+    <set-variable variableName="salesforceId"
+                  value="#[payload[0].id]"
+                  doc:name="Save Salesforce record ID"/>
+
     <set-payload value='#[{ "orderId": vars.orderId, "status": "accepted" }]'
                  mimeType="application/json"
                  doc:name="Build response"/>

     <error-handler>
-      <on-error-propagate type="DB:CONNECTIVITY">
+      <on-error-continue type="DB:CONNECTIVITY" logException="true">
         <logger level="ERROR"
-                message="#['Database error: ' ++ error.description]"/>
-      </on-error-propagate>
+                message='#["[" ++ vars.correlationId ++ "] DB connectivity error: " ++ error.description]'/>
+        <set-payload value='#[{ "error": "Service temporarily unavailable. Please retry." }]'
+                     mimeType="application/json"/>
+        <http:response statusCode="503"/>
+      </on-error-continue>
+
+      <on-error-propagate type="SFDC:CONNECTIVITY, SFDC:REQUEST_FAILED">
+        <logger level="ERROR"
+                message='#["[" ++ vars.correlationId ++ "] Salesforce sync failed: " ++ error.description]'/>
+      </on-error-propagate>
     </error-handler>

   </flow>
