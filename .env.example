# Anthropic API key — required for the code explainer agent (src/explainer_agent.py)
# Generate at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# GitHub personal access token (used by our custom MCP server)
# Generate at: https://github.com/settings/tokens
# Required scopes: repo (for private repos) or public_repo (for public repos only)
GITHUB_TOKEN=your_github_token_here

# GitHub personal access token for the official GitHub MCP server
# Same token and scopes as above — can be the same value
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_token_here
